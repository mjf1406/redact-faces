# Public base URL for the Accurate pack (det_10g.onnx and w600k_r50.onnx).
# Leave empty to hide the Accurate option. No trailing slash.
VITE_LARGE_MODEL_BASE_URL=

# Optional override for the WebGPU runtime directory. Leave empty to use
# ${VITE_LARGE_MODEL_BASE_URL}/ort/ in production builds, and /ort/ from this site
# during bun run dev. Set a trailing slash only if the runtime lives somewhere else.
VITE_ORT_WASM_BASE_URL=
