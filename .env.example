# Public base URL for the Accurate pack (det_10g.onnx and w600k_r50.onnx).
# Leave empty to hide the Accurate option. No trailing slash.
VITE_LARGE_MODEL_BASE_URL=

# If an ORT wasm file exceeds Cloudflare's 25 MiB limit, upload the files from
# public/ort (or the skipped list in public/ort/manifest.json) to R2 and set this
# to that directory URL, with a trailing slash. Leave empty to serve /ort/ from this site.
VITE_ORT_WASM_BASE_URL=
